# Copy this to .env and fill in real values

# Twilio: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number SID (starts with PN)
# Twilio Console -> Phone Numbers -> Manage -> Active numbers -> click your number -> it's in the URL
TWILIO_PHONE_SID=PNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Deepgram: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Set to "false" during initial local testing
VALIDATE_TWILIO=true

# TTS voice / rate (optional, inherits from speak.py defaults)
# SPEAK_VOICE=en-US-AriaNeural
# SPEAK_RATE=+15%

# ffmpeg path (optional, defaults shown)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Numbers allowed to drive this machine by phone, comma separated. Any format
# works, only the digits are compared. REQUIRED: if this is empty every call is
# rejected, because anything the caller says gets typed into a live terminal.
ALLOWED_CALLERS=+15551112222

# Shared secret for /session/register and /session/deregister. The public tunnel
# exposes every route, so these need their own gate. REQUIRED.
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_TOKEN=generate_a_long_random_string_here

# Your public tunnel URL, no trailing slash (Cloudflare Tunnel, ngrok, etc.)
BRIDGE_URL=https://your-tunnel-hostname.example.com

# ---- Mishearing and safety (all optional, defaults shown) ----

# What the bridge says the moment it types your words in.
#   off       nothing. The typing sound starts, so you know it is working. This
#             is the default: a canned "Yup." right after a question sounds like
#             the answer to the question.
#   short     one of the canned phrases, "On it.", "Got it." and so on.
#   readback  repeats what it heard, in the flavour READBACK names below.
# ACK_MODE=off

# Only used when ACK_MODE=readback, where it picks the flavour of the read-back:
# transcript ("I heard: ..." cut to about 20 words), or haiku (a short
# restatement from Claude Haiku, falls back to transcript on any failure), or
# off (nothing, same as ACK_MODE=off). ACK_MODE wins: with ACK_MODE=off or
# short, READBACK does nothing at all.
# READBACK=transcript

# Needed only for READBACK=haiku.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# How long to wait for the Haiku restatement before using the transcript, in ms.
# READBACK_HAIKU_TIMEOUT_MS=2500

# The caller's phone speaker plays the bridge's own voice back into the phone
# mic. Echo is possible while the bridge is speaking and for this many
# milliseconds after its audio runs out. In that window an utterance that
# repeats what the bridge is saying is dropped; anything else is you cutting in,
# and the bridge stops talking and takes it. Stop words always work.
# ECHO_GUARD_MS=1200

# Saying one of these as the whole utterance presses Escape to stop the current
# turn instead of sending it as a prompt. Comma list, replaces the defaults.
# VOICE_STOP_WORDS=stop,cancel,wait,hold on,never mind

# Extra spellings that count as a stop word. Deepgram drops the first sound of a
# short utterance now and then, so "stop" arrives as "top" and used to get typed
# in as a prompt. Format: command=spelling|spelling, comma separated. This is a
# fixed list, not a fuzzy match, so behaviour stays predictable: "top" alone
# stops the turn, "top of the file" is still sent as a prompt. An alias only
# counts when its command is one of VOICE_STOP_WORDS above. Set it to an empty
# value to accept the exact stop words only. Replaces the defaults, which are:
# VOICE_STOP_ALIASES=stop=top|op|stopp|stahp,cancel=ancel|cansel,wait=ait|weight,hold on=old on|holdon,never mind=nevermind|ever mind

# on (the default): talking over the bridge also presses Escape, so cutting it
# off stops the work as well as the voice - the same as saying "stop". off: it
# stops the voice only and the turn keeps running, and its answer is dropped
# rather than read out late.
# BARGE_IN_STOPS_CLAUDE=on

# on (the default): decide barge-in from Deepgram's partial transcripts, which
# land a few hundred milliseconds into a sentence. off: wait for the finished
# utterance, which needs UTTERANCE_END_MS of quiet and so cannot arrive until
# you stop talking - on a real call that left the bridge talking over the caller
# for nearly four seconds. Partial text is only used to decide whether to stop
# talking; it is never typed into the session.
# BARGE_IN_ON_INTERIM=on

# on: the session is told to say what it will do and wait for a yes before
# destructive or outward-facing actions. This is an instruction to the model,
# not a hard block. Read by claude-voice.ps1.
# CONFIRM_RISKY=on

# on: the session is told to answer in short spoken sentences and hand long
# work to background agents. Read by claude-voice.ps1.
# VOICE_COORDINATOR=on

# on: the session is told to acknowledge the request in one spoken sentence before
# it does anything, and to say one short line before any step that takes more than
# a moment. The watcher speaks assistant text as it is written, so this is what the
# caller hears instead of silence. Read by claude-voice.ps1.
# VOICE_NARRATE=on

# on: the PreToolUse hook speaks a canned line for each tool call, such as
# Reading bridge.py... Off by default, because VOICE_NARRATE has Claude do the
# talking and it knows what it is doing. Only turn this on with VOICE_NARRATE=off.
# TOOL_PHRASES=off

# Words Deepgram should listen harder for, such as project names. Comma list.
# DEEPGRAM_KEYTERMS=

# How text gets into the Claude Code session.
#   auto    (default) write to the session's console input buffer, and only if
#           that fails fall back to the clipboard-and-focus path
#   console console input buffer only, never touch the clipboard or focus
#   keys    the old path only: clipboard, pull the window to the front, Ctrl+V
# INJECT_METHOD=auto
