# Copy this to .env and fill in real values

# Twilio: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number SID (starts with PN)
# Twilio Console -> Phone Numbers -> Manage -> Active numbers -> click your number -> it's in the URL
TWILIO_PHONE_SID=PNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Deepgram: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Set to "false" during initial local testing
VALIDATE_TWILIO=true

# TTS voice / rate (optional, inherits from speak.py defaults)
# SPEAK_VOICE=en-US-AriaNeural
# SPEAK_RATE=+15%

# ffmpeg path (optional, defaults shown)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Numbers allowed to drive this machine by phone, comma separated. Any format
# works, only the digits are compared. REQUIRED: if this is empty every call is
# rejected, because anything the caller says gets typed into a live terminal.
ALLOWED_CALLERS=+15551112222

# Shared secret for /session/register and /session/deregister. The public tunnel
# exposes every route, so these need their own gate. REQUIRED.
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_TOKEN=generate_a_long_random_string_here

# Your public tunnel URL, no trailing slash (Cloudflare Tunnel, ngrok, etc.)
BRIDGE_URL=https://your-tunnel-hostname.example.com

# ---- Mishearing and safety (all optional, defaults shown) ----

# What the bridge says after it types your words in: off (canned "Got it."),
# transcript ("I heard: ..." cut to about 20 words), or haiku (a short
# restatement from Claude Haiku, falls back to transcript on any failure).
# READBACK=transcript

# Needed only for READBACK=haiku.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# How long to wait for the Haiku restatement before using the transcript, in ms.
# READBACK_HAIKU_TIMEOUT_MS=2500

# Saying one of these as the whole utterance presses Escape to stop the current
# turn instead of sending it as a prompt. Comma list, replaces the defaults.
# VOICE_STOP_WORDS=stop,cancel,wait,hold on,never mind

# on: the session is told to say what it will do and wait for a yes before
# destructive or outward-facing actions. This is an instruction to the model,
# not a hard block. Read by claude-voice.ps1.
# CONFIRM_RISKY=on

# on: the session is told to answer in short spoken sentences and hand long
# work to background agents. Read by claude-voice.ps1.
# VOICE_COORDINATOR=on

# Words Deepgram should listen harder for, such as project names. Comma list.
# DEEPGRAM_KEYTERMS=
